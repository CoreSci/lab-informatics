# Binary assets: never convert line endings or diff as text
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.zip  binary
# JCAMP-DX is ASCII text; keep LF so the files stay byte-identical to the generator output
*.jdx  text eol=lf
# mzML is XML text; keep LF so the byte offsets in indexed files stay valid and the files stay byte-identical to the generator output
*.mzML text eol=lf
